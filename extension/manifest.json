{
  "manifest_version": 3,
  "name": "Image Lightbox for GitHub",
  "version": "1.0.0",
  "description": "Abre las imágenes de issues, pull requests y comentarios de GitHub en un visor con zoom, sin salir de la página.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://github.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}